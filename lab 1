# Zadanie 8
import math
a_kw = float(input("Podaj a: "))
b_kw = float(input("Podaj b: "))
c_kw = float(input("Podaj c: "))
if a_kw == 0:
    print("To nie jest równanie kwadratowe.")
else:
    delta = b_kw**2 - 4 * a_kw * c_kw
    if delta > 0:
        x1 = (-b_kw - math.sqrt(delta)) / (2 * a_kw)
        x2 = (-b_kw + math.sqrt(delta)) / (2 * a_kw)
        print(f"x1 = {x1:.2f}, x2 = {x2:.2f}")
    elif delta == 0:
        x0 = -b_kw / (2 * a_kw)
        print(f"x0 = {x0:.2f}")
    else:
        print("Brak rozwiązań.")

